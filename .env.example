# --- Postgres ---
POSTGRES_USER=scrabble
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scrabble
DATABASE_URL=postgres://scrabble:change-me@localhost:5432/scrabble

# --- Backend ---
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
# The two known players. Passwords are bcrypt hashes, generate with:
#   node packages/backend/scripts/hash-password.mjs "yourpassword"
PLAYER1_USERNAME=alice
PLAYER1_PASSWORD_HASH=
PLAYER2_USERNAME=bob
PLAYER2_PASSWORD_HASH=

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Frontend (build-time) ---
VITE_VAPID_PUBLIC_KEY=
VITE_SOCKET_URL=https://scrabble.example.com

# --- Caddy (prod only) ---
# Public domain pointing at the VPS, used for the reverse proxy and its
# automatic Let's Encrypt certificate. Must match VITE_SOCKET_URL above.
DOMAIN=scrabble.example.com
